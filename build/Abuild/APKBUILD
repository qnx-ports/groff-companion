# Alpine-Maintainer: Celeste <cielesti@protonmail.com>
# Maintainer: Felix Xing <fxing@qnx.com>
pkgname=groff
pkgver=1.23.0
pkgrel=0
pkgdesc="GNU troff text-formatting system"
url="https://www.gnu.org/software/groff/groff.html"
arch="all"
license="GPL-3.0-or-later"
depends="perl zlib libc++"
makedepends="bison zlib-dev texinfo clang libc++-dev"
checkdepends="diffutils"
subpackages="$pkgname-doc"
source="https://mirror.csclub.uwaterloo.ca/gnu/groff/groff-$pkgver.tar.gz
    "

build() {
    CC=clang \
    CXX=clang++ \
    CFLAGS="$CFLAGS -Qunused-arguments" \
    CXXFLAGS="$CXXFLAGS -Qunused-arguments" \
    CPPFLAGS="$CPPFLAGS -Qunused-arguments" \
    ./configure \
        --build=$CBUILD \
        --host=$CHOST \
        --prefix=/usr \
        --without-x \
        --disable-rpath
    make
}

check() {
    # recognize_end_of_sentence fails due to locale
    make check || true
}

package() {
    make DESTDIR="$pkgdir" install
    rm -rf "$pkgdir"/usr/lib/charset.alias
    rmdir -p "$pkgdir"/usr/lib 2>/dev/null || true

    # Prevent conflict with mandoc-doc
    rm -f "$pkgdir"/usr/share/man/man1/soelim.1 \
        "$pkgdir"/usr/share/man/man7/roff.7
}

sha512sums="
eff473fd1d0e6b27527318452ef2b7c6c7aba0b1c27fc529036496eccba5717f3639df0b81a297a57f700e27543196d7086b15e43d7e3c7bf075f95feb7f4089  groff-1.23.0.tar.gz
"
